# DriftGuard Environment Configuration
# Copy this file to .env and fill in values for your environment.

# Application
APP_ENV=development
LOG_LEVEL=INFO
DRIFT_THRESHOLD=0.30
PSI_THRESHOLD=0.20
KS_ALPHA=0.05

# Paths (relative to project root or container /app)
DATA_RAW_PATH=data/raw/PRSA_data_2010.1.1-2014.12.31.csv
DATA_PROCESSED_DIR=data/processed
ARTIFACTS_MODELS_DIR=artifacts/models
ARTIFACTS_MONITORING_DIR=artifacts/monitoring

# GitHub Actions Integration (Optional - for remote CI/CD dispatch)
# Never commit real tokens to version control.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=DriftGuard
GITHUB_WORKFLOW_EVENT=drift-detected

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8000
